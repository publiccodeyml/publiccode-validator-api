#
# This is the Docker image that gets published to GitHub.
#
# Goreleaser takes care of building the binary.
#
FROM alpine:3@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

RUN addgroup -S validator && adduser -S -G validator validator

# GoReleaser places each binary under a directory named after its platform.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/publiccode-validator-api /usr/local/bin/publiccode-validator-api

USER validator
ENTRYPOINT ["/usr/local/bin/publiccode-validator-api"]
